# Copy to .env and edit. Everything is optional; defaults work with zero external services.
DATA_DIR=./data
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
MAX_UPLOAD_MB=10

# Optional shared secret. If set, clients must send header  X-API-Key: <value>  (except /health)
API_KEY=

# Optional LLM answer step (any OpenAI-compatible /chat/completions endpoint).
# Local Ollama example:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional embeddings for hybrid BM25 + semantic retrieval (OpenAI-compatible /embeddings).
# Local Ollama example:  EMBEDDINGS_BASE_URL=http://localhost:11434/v1   EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_WEIGHT=0.5
